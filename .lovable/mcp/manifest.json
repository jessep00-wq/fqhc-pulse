{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://eeyigxcwewdqfeidqbxk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "measurewise-mcp",
      "version": "0.1.0",
      "title": "MeasureWise"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in user's email, user id, and their MeasureWise organization (id, name, plan). Use to confirm authentication and current org context.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_pdsa_cycles",
        "title": "List PDSA cycles",
        "description": "List the signed-in user's organization's PDSA (Plan-Do-Study-Act) quality improvement cycles. Returns id, title/aim, phase, completeness score, and timestamps. Results are scoped by RLS to the caller's organization.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "description": "Maximum number of cycles to return."
            },
            "phase": {
              "type": "string",
              "enum": [
                "plan",
                "do",
                "study",
                "act",
                "completed"
              ],
              "description": "Optional PDSA phase filter."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_pdsa_cycle",
        "title": "Get PDSA cycle",
        "description": "Fetch full details of a single PDSA cycle by id (aim, intervention, predicted vs. actual outcome, analysis, next steps). Scoped by RLS to the caller's organization.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "PDSA cycle UUID."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_qi_reports",
        "title": "List QI reports",
        "description": "List the caller's organization's Quality Improvement board/committee reports with id, title, status, and timestamps. Scoped by RLS.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
